# Dipendenze e build
node_modules
dist
data
*.tsbuildinfo
package-lock.json

# Segreti e ambiente (il build non ne ha bisogno)
.env
.env.*

# Git, GitHub e documentazione
.git
.github
.gitignore
README.md
ISSUES.md
LICENSE.txt
