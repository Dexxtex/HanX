{
  "name": "hanx",
  "version": "12.4.23",
  "description": "HanX - addon Stremio/NUVIO esclusivo per anime (AnimeUnity, AnimeSaturn, AnimeWorld)",
  "main": "dist/addon.js",
  "packageManager": "pnpm@12.10.1",
  "resolutions": {
    "tar": "^7.5.21",
    "@keyv/sqlite": "^6.1.0"
