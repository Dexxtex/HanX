    "cacheable": "^2.5.0",
    "cheerio": "^1.1.2",
    "express": "^4.18.2",
    "got-scraping": "^4.2.2",
    "https-proxy-agent": "7.0.6",
    "jsdom": "^26.1.0",
    "node-fetch": "^2.6.7",
    "randomstring": "^1.3.2",
    "sax": "^1.6.1",
    "slugify": "^1.6.9",
    "socks-proxy-agent": "8.0.5",
    "stremio-addon-sdk": "^1.6.10",
    "tough-cookie": "^4.1.4",
    "undici": "^8.11.2",
