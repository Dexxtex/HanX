{
  "name": "hanx",
  "version": "1.1.1",
  "description": "HanX - addon Stremio/NUVIO esclusivo per anime (AnimeUnity, AnimeSaturn, AnimeWorld)",
  "main": "dist/addon.js",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc && node scripts/build/build-copy.js",
    "start": "node --env-file-if-exists=.env dist/addon.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/addon.ts",
    "test": "pnpm run build && node --import ./tests/setup.mjs --test \"tests/**/*.test.mjs\"",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "mapping:build": "node scripts/build/build-anime-mapping.mjs",
    "mapping:check": "node scripts/build/build-anime-mapping.mjs --check",
    "mapping:verify": "pnpm run mapping:check && node --test tests/mapping/index.test.mjs tests/mapping/generator.test.mjs",
    "verify:status": "node scripts/ops/verify-feature.mjs status",
    "check:domains": "node scripts/ops/check_domains.cjs",
    "sync-catalog": "node --import tsx scripts/sync/sync-catalog.ts",
    "enrich-catalog": "node --import tsx scripts/sync/sync-catalog.ts --enrich-only"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "express": "^5.3.0",
    "node-fetch": "^3.3.2",
    "socks-proxy-agent": "^10.1.0",
    "stremio-addon-sdk": "^1.6.10",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
