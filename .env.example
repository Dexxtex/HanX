#############################################
# HANX Environment Configuration
# Copy this file to .env and adjust values.
# All variables are optional; defaults are applied in code.
# Variables with a matching manifest field prefill the landing page / link.
#############################################

# Porta del server (default: 7000)
PORT=7000

# =============================================================================
# EASYPROXY (riproduzione via proxy)
# =============================================================================

# URL base di EasyProxy, esterno all'addon
# Esempio: http://localhost:7860
EASYPROXY_URL=

# Password API di EasyProxy (API_PASSWORD)
EASYPROXY_PASSWORD=

# =============================================================================
# CHIAVI API
# =============================================================================

# TMDB per metadati e ricerca
TMDB_API_KEY=

# TVDB v4: live fallback del mapping e converter
TVDB_API_KEY=
# PIN TVDB (solo se il progetto TVDB lo richiede)
TVDB_PIN=

# =============================================================================
# PROXY DI RETE (RICERCA E RIPRODUZIONE)
# ============================================================================
# Forward proxy HTTP/SOCKS per i siti dei provider; si attiva appena impostato.
# Catena: proxy di piattaforma -> PROXY -> diretto.

PROXY=
AU_PROXY=
AS_PROXY=
AW_PROXY=

# =============================================================================
# MAPPING ANIME
# =============================================================================
# Indice remoto pubblicato dalla workflow "Anime Mapping" (branch "mapping"):
# scaricato al primo avvio, ricontrollato ogni 24h via ETag.
# ANIME_MAPPING_URL=https://raw.githubusercontent.com/Dexxtex/HanX/mapping/anime-seasons.json

# =============================================================================
# ANIME GATE - FILTRO CONTENUTI
# =============================================================================

# Verifica che il titolo sia effettivamente anime (default: true)
ANIME_GATE_ENABLED=true

# Fallback TMDB per il gate (default: true)
ANIME_GATE_TMDB_FALLBACK=true

# =============================================================================
# DEBUG
# =============================================================================

# 0=off, 1=lifecycle, 2=flow, 3=details, 4=trace (default: 0)
DEBUG_LEVEL=0

# =============================================================================
# TUNING (opzionali)
# =============================================================================
# Il resto e' tunabile da env ma ha default sani nel codice: timeout per
# provider (ANIMEUNITY/ANIMESATURN/ANIMEWORLD_FETCH_TIMEOUT_MS), cache
# provider (PROVIDER_CACHE_TTL_MS, PROVIDER_CACHE_MAX_ENTRIES), provider
# URLs (PROVIDER_URLS_*), rate limiter Tenrai (TENRAI_*), UA e flag
# specifici. Cerca "process.env" in src/ se ti serve uno di questi.
