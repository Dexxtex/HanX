#############################################
# HANX — variabili d'ambiente
# =============================================================================
# OBBLIGATORIE
# =============================================================================

# 1. MAPPING — traduce gli id di Stremio (kitsu/imdb/tmdb/tvdb/mal) in titolo e
# stagione. Senza questa riga l'indice non viene scaricato e nessun id si
# risolve: è l'unica variabile la cui assenza rende l'addon inutilizzabile.
ANIME_MAPPING_URL=https://raw.githubusercontent.com/Dexxtex/HanX/mapping/anime-seasons.json

# 2. CATALOGO — le schede dei tre siti, riscritte ogni sera alle 20:00 italiane
# sul branch orfano `data`. Senza, ogni titolo richiede una ricerca di rete.
# L'addon lo scarica all'avvio e lo ricontrolla ogni 6 ore (al massimo un
# download al giorno).
CATALOG_URL=https://raw.githubusercontent.com/Dexxtex/HanX/data/catalog-titles.json

# 3. TMDB — titoli italiani, metadati e anime gate. Senza chiave il mapping usa
# solo i titoli inglesi/romaji: i siti italiani elencano spesso in italiano,
# quindi si perdono molti match.
TMDB_API_KEY=

# =============================================================================
# OPZIONALI
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

# Porta HTTP dell'addon (default: 7000)
PORT=7000

# Cartella di lavoro del catalogo e dell'indice (default: /app/data
# nell'immagine). Deve stare su un volume, altrimenti il container riscarica a
# ogni ricreazione.
# CATALOG_DIR=/app/data

# NON usare questo come CATALOG_URL: è l'indice completo, con `titleSite`
# invece di `title`. Serve a occhio, o a uno script, non all'addon.
# https://raw.githubusercontent.com/Dexxtex/HanX/data/catalogs.json

# -----------------------------------------------------------------------------
# CHIAVI API FACOLTATIVE
# -----------------------------------------------------------------------------

# TVDB v4: ordine episodi e fallback del mapping (l'addon funziona anche senza)
TVDB_API_KEY=
# PIN del progetto TVDB (solo se il progetto lo richiede)
TVDB_PIN=

# -----------------------------------------------------------------------------
# EASYPROXY (riproduzione HLS via proxy)
# -----------------------------------------------------------------------------

# URL base di EasyProxy, esterno all'addon. Esempio: http://localhost:7860
EASYPROXY_URL=
# API_PASSWORD di EasyProxy
EASYPROXY_PASSWORD=

# -----------------------------------------------------------------------------
# PROXY DI RETE (solo ricerca e scraping, non il catalogo)
# -----------------------------------------------------------------------------
# Forward proxy HTTP/SOCKS: si attiva appena impostato. Catena:
# proxy di piattaforma -> PROXY -> proxy del singolo provider -> diretto.

PROXY=
AU_PROXY=
AS_PROXY=
AW_PROXY=

# -----------------------------------------------------------------------------
# PROVIDER
# -----------------------------------------------------------------------------

# Sorgenti attive (default: true). `false` toglie il provider dal manifest.
ANIMEUNITY_ENABLED=true
ANIMESATURN_ENABLED=true
ANIMEWORLD_ENABLED=true

# AnimeUnity: 1 = preferisci gli stream MP4 diretti (default: 0)
ANIMEUNITY_PREFER_MP4=0

# AnimeWorld: accetta anche i risultati senza titolo (default: false)
AW_ALLOW_EMPTY_TITLE=

# Timeout HTTP per provider, in millisecondi (default: 10000 ciascuno)
ANIMEUNITY_FETCH_TIMEOUT_MS=10000
ANIMESATURN_FETCH_TIMEOUT_MS=10000
ANIMEWORLD_FETCH_TIMEOUT_MS=10000
# Timeout dei servizi interni (TMDB, Tenrai): default 10000
ANIME_FETCH_TIMEOUT_MS=10000

# User-Agent per provider (vuoto = quello predefinito nel codice)
AU_USER_AGENT=
AS_USER_AGENT=
AW_USER_AGENT=

# Distanza minima tra due richieste allo stesso host, in millisecondi
# (default: 2000). Alzala se un sito comincia a rispondere 429.
ANIME_HOST_MIN_INTERVAL_MS=2000

# Anime gate: scarta i titoli che non sono anime (default: true)
ANIME_GATE_ENABLED=true
# Fallback TMDB quando Kitsu non basta (default: true)
ANIME_GATE_TMDB_FALLBACK=true

# -----------------------------------------------------------------------------
# CACHE E URL DEI PROVIDER
# -----------------------------------------------------------------------------

# Cache in memoria dei risultati dei provider (default: 5 minuti, 500 voci)
PROVIDER_CACHE_TTL_MS=300000
PROVIDER_CACHE_MAX_ENTRIES=500

# File locale dei domini dei provider (default: config/provider_urls.json)
# PROVIDER_URLS_FILE=/app/config/provider_urls.json
# URL remoto degli stessi domini (default: quello di easystreams)
# PROVIDER_URLS_URL=
# Ricontrollo del file locale e dell'URL remoto, in millisecondi
PROVIDER_URLS_RELOAD_MS=1500
PROVIDER_URLS_REMOTE_RELOAD_MS=10000
PROVIDER_URLS_REMOTE_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# TENRAI (metadati episodi)
# -----------------------------------------------------------------------------

TENRAI_API_BASE_URL=https://api.tenrai.org/v1
# TENRAI_SERVER_KEY=      (accettato solo per api.tenrai.org)
TENRAI_REQUEST_TIMEOUT_MS=8000
TENRAI_CACHE_TTL_MS=3600000
TENRAI_NEGATIVE_CACHE_TTL_MS=21600000
TENRAI_MAX_REQUESTS_PER_SECOND=3
TENRAI_MAX_REQUESTS_PER_MINUTE=100
TENRAI_MAX_PENDING_REQUESTS=100
TENRAI_MAX_QUEUE_WAIT_MS=10000
TENRAI_FAILURE_BACKOFF_MS=15000
TENRAI_MAX_BACKOFF_MS=3600000
TENRAI_STALE_IF_ERROR=true
# TENRAI_CACHE_DB_PATH=/app/data/tenrai-metadata.sqlite

# -----------------------------------------------------------------------------
# OVERRIDE DEI DOMINI
# -----------------------------------------------------------------------------
# Se un sito cambia dominio e l'aggiornamento automatico non c'è ancora, si
# possono forzare qui. Vuoto = dominio da config/provider_urls.json.
# ANIMEUNITY_BASE_URL=
# AU_BASE_URL=
# ANIMESATURN_BASE_URL=
# AS_BASE_URL=
# ANIMEWORLD_BASE_URL=
# AW_BASE_URL=

# -----------------------------------------------------------------------------
# DEBUG
# -----------------------------------------------------------------------------

# 0=off, 1=lifecycle, 2=flow (include i log `catalog-lookup`), 3=details,
# 4=trace. Default: 0
DEBUG_LEVEL=0
# Compatibilità: DEBUG_LOG è accettato ma DEBUG_LEVEL ha la precedenza.
# DEBUG_LOG=
