#############################################
# HANX Environment Configuration
# Copy this file to .env and adjust values.
# All variables are optional; defaults are applied in code.
# Variables with a matching manifest field prefill the landing page / link.
#############################################

# =============================================================================
# SERVER & CONFIGURAZIONE BASE
# =============================================================================

# Porta del server (default: 7000)
PORT=7000

# =============================================================================
# EASYPROXY
# =============================================================================

# URL base di EasyProxy, esterno all'addon (opzionale)
# Esempio: http://localhost:7860
EASYPROXY_URL=

# Password API di EasyProxy (API_PASSWORD, opzionale)
EASYPROXY_PASSWORD=

# =============================================================================
# TMDB API
# =============================================================================

# Chiave API TMDB per metadati e ricerca (opzionale)
TMDB_API_KEY=

# =============================================================================
# TVDB API v4 (mapping anime, opzionale a runtime)
# =============================================================================

# Chiave API TVDB v4 (serve per il live fallback e per mapping:build)
TVDB_API_KEY=

# PIN TVDB (solo se il progetto TVDB lo richiede)
TVDB_PIN=

# =============================================================================
# ANIME MAPPING (locale + API ufficiali)
# =============================================================================

# L'indice spedito è vuoto: esegui `pnpm mapping:build` con TMDB_API_KEY e
# TVDB_API_KEY, oppure lascia entrambe le chiavi impostate per il fallback live.
# File indice alternativo (default: src/mapping/data/anime-seasons.json)
# ANIME_MAPPING_FILE=

# File override alternativo (default: src/mapping/overrides.json)
# ANIME_MAPPING_OVERRIDES=

# =============================================================================
# PROXY DI RETE (SCRAPING)
# =============================================================================

# Di default le ricerche e le pagine dei provider vengono scaricate dirette.
# Metti true solo se l'IP diretto viene bloccato/rate-limited: allora PROXY e
# i *_PROXY tornano a essere usati (piattaforma -> globale -> diretto).
SEARCH_VIA_PROXY=

# Proxy globale usato dal server per raggiungere i siti provider (opzionale).
# Usato solo con SEARCH_VIA_PROXY=true; provato dopo il proxy di piattaforma.
PROXY=

# Whitelist host proxy consentiti (comma-separated, opzionale)
ALLOWED_PROXY_HOSTS=

# =============================================================================
# ANIME - CONFIGURAZIONE GENERALE
# =============================================================================

# Timeout fetch per AnimeUnity in millisecondi (default: 10000)
# ANIMEUNITY_FETCH_TIMEOUT_MS=

# Timeout fetch per AnimeSaturn in millisecondi (default: 10000)
# ANIMESATURN_FETCH_TIMEOUT_MS=

# Timeout fetch per AnimeWorld in millisecondi (default: 10000)
# ANIMEWORLD_FETCH_TIMEOUT_MS=

# Timeout generico fetch anime in millisecondi (default: 10000)
# ANIME_FETCH_TIMEOUT_MS=

# User-Agent personalizzato per AnimeUnity (opzionale)
# AU_USER_AGENT=

# User-Agent personalizzato per AnimeSaturn (opzionale)
# AS_USER_AGENT=

# User-Agent personalizzato per AnimeWorld (opzionale)
# AW_USER_AGENT=

# Proxy specifico per AnimeUnity (opzionale; usato prima del proxy globale)
# AU_PROXY=

# Proxy specifico per AnimeSaturn (opzionale; usato prima del proxy globale)
# AS_PROXY=

# Proxy specifico per AnimeWorld (opzionale; usato prima del proxy globale)
# AW_PROXY=

# Preferisci formato MP4 per AnimeUnity (1/true/on = true, default: 0)
ANIMEUNITY_PREFER_MP4=0

# Consenti titoli vuoti per AnimeWorld (true/false, default: false)
AW_ALLOW_EMPTY_TITLE=false

# =============================================================================
# ANIME GATE - FILTRO CONTENUTI
# =============================================================================

# Abilita gate anime (verifica che il titolo sia effettivamente anime) (default: true)
ANIME_GATE_ENABLED=true

# Abilita fallback TMDB per gate (true/false, default: true)
ANIME_GATE_TMDB_FALLBACK=true

# Abilita placeholder warning per gate (true/false, default: true)
ANIME_GATE_PLACEHOLDER_ENABLED=true

# =============================================================================
# PROVIDER URLS - AGGIORNAMENTO URL
# =============================================================================

# Path file JSON provider URLs personalizzato (opzionale, default: config/provider_urls.json)
# PROVIDER_URLS_FILE=

# Intervallo reload provider URLs in ms (default: 1500)
# PROVIDER_URLS_RELOAD_MS=

# URL remoto per provider URLs (default: GitHub raw easystreams)
# PROVIDER_URLS_URL=

# Intervallo reload remoto in ms (default: 10000)
# PROVIDER_URLS_REMOTE_RELOAD_MS=

# Timeout richiesta remota provider URLs in ms (default: 5000)
# PROVIDER_URLS_REMOTE_TIMEOUT_MS=

# =============================================================================
# CACHE & DEBUG
# =============================================================================

# Livello debug: 0=off, 1=lifecycle, 2=flow, 3=details, 4=trace (default: 0)
DEBUG_LEVEL=0

# Compatibilità legacy: usato solo se DEBUG_LEVEL non è impostato.
# true/on/yes = 2, false/off/no = 0, un numero = quel livello.
# DEBUG_LOG=false

# TTL cache provider in millisecondi (default: 300000 = 5 min)
# PROVIDER_CACHE_TTL_MS=

# Max entry nella cache provider (default: 500)
# PROVIDER_CACHE_MAX_ENTRIES=

# Tenrai metadata cache and request safety limits
TENRAI_API_BASE_URL=https://api.tenrai.org/v1
TENRAI_CACHE_DB_PATH=./data/tenrai-metadata.sqlite
TENRAI_REQUEST_TIMEOUT_MS=8000
TENRAI_CACHE_TTL_MS=3600000
TENRAI_NEGATIVE_CACHE_TTL_MS=21600000
TENRAI_STALE_IF_ERROR=true
TENRAI_MAX_REQUESTS_PER_SECOND=3
TENRAI_MAX_REQUESTS_PER_MINUTE=100
TENRAI_MAX_PENDING_REQUESTS=100
TENRAI_MAX_QUEUE_WAIT_MS=10000
TENRAI_FAILURE_BACKOFF_MS=15000
TENRAI_MAX_BACKOFF_MS=3600000
TENRAI_SERVER_KEY=
