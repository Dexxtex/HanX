#############################################
# HANX — variabili d'ambiente
# =============================================================================
# OBBLIGATORIE
# =============================================================================

# 1. MAPPING — id di Stremio (kitsu/imdb/tmdb/tvdb/mal) -> titolo e stagione.
# Senza, ogni id passa dalla risoluzione live: funziona, ma più lento.
ANIME_MAPPING_URL=https://raw.githubusercontent.com/Dexxtex/HanX/mapping/anime-seasons.json

# 2. CATALOGO — le schede dei tre siti, riscritte ogni sera (~20:37 italiane)
# sul branch `data`. Senza, ogni titolo costa una ricerca di rete. L'addon lo
# ricontrolla ogni 6 ore (un download al giorno).
CATALOG_URL=https://raw.githubusercontent.com/Dexxtex/HanX/data/catalogs.json

# 3. TMDB — titoli italiani, metadati e anime gate. Senza chiave il mapping usa
# solo i titoli inglesi/romaji: i siti italiani elencano spesso in italiano,
# quindi si perdono molti match.
TMDB_API_KEY=

# =============================================================================
# OPZIONALI
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

# Porta HTTP dell'addon (default: 7000)
PORT=7000

# Cartella di lavoro del catalogo (default: /app/data
# nell'immagine). Deve stare su un volume, altrimenti il container riscarica a
# ogni ricreazione.
# CATALOG_DIR=/app/data

# -----------------------------------------------------------------------------
# CHIAVI API FACOLTATIVE
# -----------------------------------------------------------------------------

# TVDB v4: ordine episodi e fallback del mapping (l'addon funziona anche senza)
TVDB_API_KEY=
# PIN del progetto TVDB (solo se il progetto lo richiede)
TVDB_PIN=

# -----------------------------------------------------------------------------
# EASYPROXY (riproduzione HLS via proxy)
# -----------------------------------------------------------------------------

# URL base di EasyProxy, esterno all'addon. Esempio: http://localhost:7860
EASYPROXY_URL=
# API_PASSWORD di EasyProxy
EASYPROXY_PASSWORD=

# -----------------------------------------------------------------------------
# PROXY DI RETE (solo ricerca e scraping, non il catalogo)
# -----------------------------------------------------------------------------
# Forward proxy HTTP/SOCKS: si attiva appena impostato. Catena:
# proxy di piattaforma -> PROXY -> proxy del singolo provider -> diretto.

PROXY=
AU_PROXY=
AS_PROXY=
AW_PROXY=

# -----------------------------------------------------------------------------
# PROVIDER
# -----------------------------------------------------------------------------

# Sorgenti attive (default: true). `false` toglie il provider dal manifest e
# scavalca la scelta dell'utente; `true` o assente lasciano decidere la
# configurazione dell'utente (le checkbox della landing).
ANIMEUNITY_ENABLED=true
ANIMESATURN_ENABLED=true
ANIMEWORLD_ENABLED=true

# AnimeUnity: 1 = preferisci gli stream MP4 diretti (default: 0)
ANIMEUNITY_PREFER_MP4=0

# Anime gate: scarta i titoli che non sono anime (default: true). `false` e' la
# via d'uscita se il gate rifiuta un anime vero: serve a ripristinare il
# servizio senza ricostruire l'immagine.
ANIME_GATE_ENABLED=true

# Intervallo minimo tra due richieste allo stesso sito, in secondi (default:
# 0.5 = 2 al secondo). Il tetto e' per host, non per istanza: quattro container
# sullo stesso IP a 0.5 fanno gli 8 misurati sicuri. Con una sola istanza si puo'
# scendere a 0.125 (8 al secondo). Puo' solo rallentare: sotto 0.125 si torna a
# 0.125, sopra 5 si ferma a 5. Alzalo se un sito comincia a rispondere 429.
ANIME_HOST_MIN_INTERVAL_SEC=0.5

# -----------------------------------------------------------------------------
# CACHE DEI PROVIDER
# -----------------------------------------------------------------------------
# TTL (15 minuti), voci (5.000) e TTL negativo (5 minuti) sono costanti nel
# codice: una voce pesa ~1,1 KB e il fan-out a freddo ~4 s, quindi i numeri
# giusti si misurano una volta e non si regolano da fuori.

# 1 = non servire mai stream dalla cache in memoria (utile per debuggare)
PROVIDER_CACHE_DISABLE=0

# -----------------------------------------------------------------------------
# TENRAI (metadati episodi)
# -----------------------------------------------------------------------------

# Servizio dei metadati: da qui arriva il titolo inglese quando il mapping non
# lo ha. Si usa solo nel ripiego, non su ogni richiesta.
TENRAI_API_BASE_URL=https://api.tenrai.org/v1

# Chiave server: alza i due tetti sotto da 4/120 a 5/300. Accettata solo per
# api.tenrai.org (il client la rifiuta su qualunque altro host).
# TENRAI_SERVER_KEY=

# Quanto si aspetta una risposta prima di rinunciare. I tempi di Tenrai sono in
# secondi.
TENRAI_REQUEST_TIMEOUT_SEC=5

# Per quanto si tiene un titolo trovato. Cambia praticamente mai: 24 h.
TENRAI_CACHE_TTL_SEC=86400

# Per quanto si ricorda che un id NON esiste, prima di richiederlo. 24 h.
TENRAI_NEGATIVE_CACHE_TTL_SEC=86400

# Tetto del client, non del server: 4 al secondo senza chiave (5 con), 120 al
# minuto (300 con). Il volume e' basso, restare sotto non costa niente.
TENRAI_MAX_REQUESTS_PER_SECOND=4
TENRAI_MAX_REQUESTS_PER_MINUTE=120

# Quante richieste possono essere in volo insieme: oltre, le nuove aspettano.
# 20 a 4 req/s si svuotano in 5 s, cioe' il tempo massimo di attesa qui sotto.
TENRAI_MAX_PENDING_REQUESTS=20

# Quanto una richiesta aspetta un posto libero prima di arrendersi. Tenrai e' un
# ripiego: meglio rinunciare che far aspettare il provider.
TENRAI_MAX_QUEUE_WAIT_SEC=5

# Dopo un errore il client smette di chiedere per questo tempo, poi riprova.
TENRAI_FAILURE_BACKOFF_SEC=30

# Tetto dell'attesa dopo errori ripetuti: oltre, non si allunga piu'.
TENRAI_MAX_BACKOFF_SEC=3600

# Se il servizio e' giu', serve il titolo vecchio invece di niente.
TENRAI_STALE_IF_ERROR=true

# File SQLite della cache (default: data/tenrai-metadata.sqlite nel volume).
# TENRAI_CACHE_DB_PATH=/app/data/tenrai-metadata.sqlite

# -----------------------------------------------------------------------------
# DEBUG
# -----------------------------------------------------------------------------

# 0=off, 1=lifecycle, 2=flow (include i log `catalog-lookup`), 3=details,
# 4=trace. Default: 0
DEBUG_LEVEL=0
